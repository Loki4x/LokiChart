{
  "appId": "com.loki4x.lokichart",
  "appName": "LokiChart",
  "webDir": "public",
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "BackgroundRunner": {
      "label": "com.loki4x.lokichart.alerts",
      "src": "runners/background.js",
      "event": "checkAlerts",
      "repeat": true,
      "interval": 15,
      "autoStart": true
    }
  }
}
