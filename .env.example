# Port server lokal
PORT=3000

# ===== OANDA (v20 REST API) =====
# Buat token di: OANDA hub -> Manage API Access
OANDA_API_KEY=
# practice (akun demo) atau live
OANDA_ENV=practice

# ===== FOREX.com (GAIN Capital Trading API) =====
FOREXCOM_USERNAME=
FOREXCOM_PASSWORD=
FOREXCOM_APPKEY=
# Base URL API (default di bawah). Sesuaikan jika FOREX.com memberi URL lain untuk region Anda.
FOREXCOM_BASE_URL=https://ciapi.cityindex.com/TradingAPI
# Opsional: paksa MarketId per simbol, mis. {"XAUUSD":401153869,"EURUSD":401484347}
FOREXCOM_MARKET_IDS=
